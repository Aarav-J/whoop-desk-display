menu "WHOOP Desk Display"

    config WHOOP_WIFI_SSID
        string "Wi-Fi SSID"
        default "myssid"
        help
            SSID of the Wi-Fi network the ESP32 connects to.

    config WHOOP_WIFI_PASSWORD
        string "Wi-Fi Password"
        default "mypass"
        help
            Password for the Wi-Fi network.

    config WHOOP_BACKEND_URL
        string "Backend API URL"
        default ""
        help
            URL of the backend /api/snapshot endpoint.
            Leave empty to use hardcoded stubs for development.

    menu "Waveshare 1.69\" LCD pins (SPI)"

        config WHOOP_LCD_PIN_SCLK
            int "SCLK (CLK) GPIO"
            default 12
            help
                SPI clock → LCD CLK / SCL.

        config WHOOP_LCD_PIN_MOSI
            int "MOSI (DIN) GPIO"
            default 11
            help
                SPI data → LCD DIN / SDA.

        config WHOOP_LCD_PIN_CS
            int "CS GPIO"
            default 10
            help
                Chip select → LCD CS.

        config WHOOP_LCD_PIN_DC
            int "DC GPIO"
            default 9
            help
                Data/command → LCD DC.

        config WHOOP_LCD_PIN_RST
            int "RST GPIO"
            default 14
            help
                Reset → LCD RST.

        config WHOOP_LCD_PIN_BL
            int "Backlight GPIO"
            default 13
            help
                Backlight → LCD BL (active high on Waveshare 1.69").

    endmenu

endmenu
